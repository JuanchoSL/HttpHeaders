{
    "name": "juanchosl/httpheaders",
    "description": "Little methods collection in order to create http headers",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/JuanchoSL/HttpHeaders",
    "keywords": [
        "headers",
        "http",
        "ftp",
        "file extensions",
        "mime types",
        "content types"
    ],
    "authors": [
        {
            "name": "Juan Sánchez Lecegui",
            "email": "Juan.Sanchez@tecnicosweb.com",
            "homepage": "https://www.linkedin.com/in/juansanchezlecegui/",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.0",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "9.6.*",
        "phpstan/phpstan": "1.10.*"
    },
    "autoload": {
        "psr-4": {
            "JuanchoSL\\HttpHeaders\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JuanchoSL\\HttpHeaders\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "tests": "vendor/bin/phpunit --configuration phpunit.xml tests",
        "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon"
    }
}